pipeline {
    agent any

    environment {
        APP_NAME = "react-app"
        IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Build Docker Image') {
            steps {
                // Build the image locally
                sh 'docker build -t ${APP_NAME}:${IMAGE_TAG} -f app/Dockerfile .'
            }
        }

        stage('Deploy to K3s') {
            steps {
                // 1. Securely load the image directly into K3s containerd runtime
                sh 'docker save ${APP_NAME}:${IMAGE_TAG} | sudo k3s ctr images import -'
                
                dir('app/k8s') {
                    // 2. Inject the dynamic image tag safely into the deployment file
                    sh 'sed -i "s/IMAGE_PLACEHOLDER/${IMAGE_TAG}/g" deployment.yaml'
                    
                    // 3. Apply to cluster using the local K3s config
                    sh 'sudo k3s kubectl apply -f deployment.yaml'
                    sh 'sudo k3s kubectl apply -f service.yaml'
                }
            }
        }

        stage('Rollout Verification') {
            steps {
                sh 'sudo k3s kubectl rollout status deployment/react-vite-app --timeout=90s'
            }
        }
    }
    
    post {
        always {
            // Cleanup local docker image to save disk space on the t3.micro
            sh 'docker rmi ${APP_NAME}:${IMAGE_TAG} || true'
            sh 'docker system prune -f'
        }
    }
}
